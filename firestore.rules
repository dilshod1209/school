rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isServerTimestamp(ts) {
      return ts == request.time;
    }

    // --- Validation Blueprints ---

    function isValidStudent(data) {
      return data.size() == 5 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20 &&
             data.email is string &&
             data.status in ['active', 'inactive'] &&
             data.registeredAt is timestamp;
    }

    function isValidTeacher(data) {
      return data.size() == 5 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20 &&
             data.email is string &&
             data.subject is string &&
             data.salary is number && data.salary >= 0;
    }

    function isValidGroup(data) {
      return data.size() == 6 &&
             data.name is string && data.name.size() >= 2 &&
             data.subject is string &&
             data.teacherId is string &&
             data.startTime is string &&
             data.days is list && data.days.size() <= 7 &&
             data.price is number && data.price >= 0;
    }

    function isValidEnrollment(data) {
      return data.size() == 3 &&
             data.studentId is string &&
             data.groupId is string &&
             data.joinedAt is timestamp;
    }

    function isValidAttendance(data) {
      return data.size() == 2 &&
             data.date is string &&
             data.attendedIds is list && data.attendedIds.size() <= 100;
    }

    function isValidPayment(data) {
      return data.size() == 5 &&
             data.studentId is string &&
             data.groupId is string &&
             data.amount is number && data.amount > 0 &&
             data.date is timestamp &&
             data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // --- Collection Matches ---

    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming());
      allow update: if isSignedIn() && isValidStudent(incoming()) && 
                    incoming().registeredAt == existing().registeredAt;
      allow delete: if isSignedIn();
    }

    match /teachers/{teacherId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(teacherId) && isValidTeacher(incoming());
      allow update: if isSignedIn() && isValidTeacher(incoming());
      allow delete: if isSignedIn();
    }

    match /groups/{groupId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(groupId) && isValidGroup(incoming()) &&
                    exists(/databases/$(database)/documents/teachers/$(incoming().teacherId));
      allow update: if isSignedIn() && isValidGroup(incoming()) &&
                    exists(/databases/$(database)/documents/teachers/$(incoming().teacherId));
      allow delete: if isSignedIn();

      match /enrollments/{studentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidEnrollment(incoming()) &&
                      exists(/databases/$(database)/documents/students/$(incoming().studentId));
        allow delete: if isSignedIn();
      }

      match /attendance/{attendanceId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidAttendance(incoming());
        allow update: if isSignedIn() && isValidAttendance(incoming());
        allow delete: if isSignedIn();
      }
    }

    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming()) &&
                    exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
                    exists(/databases/$(database)/documents/groups/$(incoming().groupId));
      allow delete: if isSignedIn();
    }
  }
}
